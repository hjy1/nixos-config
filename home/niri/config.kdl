// niri config, installed by home-manager (home/niri.nix).
// Change it here, then `hms` (no sudo); niri reloads it automatically. `hms`
// runs `niri validate` first, so a broken config never reaches the desktop.
//
// Dux Shell (DMS) provides the bar, launcher, notifications, lock screen and
// polkit agent, and is started by its systemd user unit (programs.dux-shell
// in modules/desktop.nix) - so it is deliberately NOT spawned here.
//
// Who owns what:
//   this file                -> structure: binds, column widths, cursor
//   ~/.config/niri/dms/*.kdl -> generated by DMS from its Settings UI (gaps,
//                               corner radius, colours, monitors). Included
//                               at the bottom so DMS settings win. NOT in
//                               git: derived from home/dms/settings.json.
//
// Full option reference: https://github.com/YaLTeR/niri/wiki/Configuration

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// Monitors: set scale/mode in DMS Settings -> Displays, which writes
// dms/outputs.kdl. Hand-written blocks here would be overridden by it.
// For reference, `niri msg outputs` shows DP-3 = LG UltraFine 4K @ 1.5.

// Without this niri asks for a theme named "default", which does not exist,
// and every cursor shape fails to load ("no default icon" in the journal).
// Adwaita is installed system-wide by the GNOME fallback session.
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

layout {
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }
}

// No spawn-at-startup "xwayland-satellite" and no DISPLAY override: niri
// 25.08+ runs xwayland-satellite itself and sets DISPLAY. Doing it here as
// well started a second copy competing for the same display.

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/niri-%Y-%m-%d-%H%M%S.png"

// DMS IPC names below were verified against a running DMS 2.1.2
// (`qs ipc -p /run/user/$UID/dms-shell/* show`). `dms ipc call` with no
// args lists them too.
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return   { spawn "ghostty"; }
    Mod+Q        { close-window; }

    // DMS: launcher, menus, panels
    Mod+Space    { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+X        { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+V        { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+N        { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Comma    { spawn "dms" "ipc" "call" "settings" "toggle"; }
    Ctrl+Shift+Escape { spawn "dms" "ipc" "call" "processlist" "toggle"; }
    Mod+Alt+L    { spawn "dms" "ipc" "call" "lock" "lock"; }

    Mod+Left     { focus-column-left; }
    Mod+Right    { focus-column-right; }
    Mod+Up       { focus-window-up; }
    Mod+Down     { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    Mod+R        { switch-preset-column-width; }
    Mod+F        { maximize-column; }
    Mod+Shift+F  { fullscreen-window; }

    Print        { screenshot; }
    Mod+Shift+E  { quit; }

    // Through DMS rather than wpctl/playerctl directly, so the on-screen
    // volume/media OSD shows.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute        allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioPlay        allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioNext        allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
}

// DMS-generated config. Last, so the DMS Settings UI wins over anything
// above. optional=true: on a fresh machine these do not exist until DMS has
// run once, and a missing non-optional include would stop niri starting.
include optional=true "dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/alttab.kdl"
include optional=true "dms/wpblur.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/windowrules.kdl"
include optional=true "dms/input.kdl"
include optional=true "dms/binds.kdl"
