[
    {
        "key": "meta+i",
        "command": "python.setInterpreter"
    },
    {
        "key": "ctrl+down",
        "command": "extension.rocq.stepForward",
        "when": "editorTextFocus && editorLangId == 'rocq'"
    },
    {
        "key": "alt+down",
        "command": "-extension.rocq.stepForward",
        "when": "editorTextFocus && editorLangId == 'rocq'"
    },
    {
        "key": "ctrl+down",
        "command": "extension.rocq.stepForward",
        "when": "resourceScheme == 'rocq-view'"
    },
    {
        "key": "alt+down",
        "command": "-extension.rocq.stepForward",
        "when": "resourceScheme == 'rocq-view'"
    },
    {
        "key": "ctrl+up",
        "command": "extension.rocq.stepBackward",
        "when": "editorTextFocus && editorLangId == 'rocq'"
    },
    {
        "key": "alt+up",
        "command": "-extension.rocq.stepBackward",
        "when": "editorTextFocus && editorLangId == 'rocq'"
    },
    {
        "key": "ctrl+up",
        "command": "extension.rocq.stepBackward",
        "when": "resourceScheme == 'rocq-view'"
    },
    {
        "key": "alt+up",
        "command": "-extension.rocq.stepBackward",
        "when": "resourceScheme == 'rocq-view'"
    },
    {
        "key": "ctrl+right",
        "command": "extension.rocq.interpretToPoint",
        "when": "editorTextFocus && config.vsrocq.proof.mode == '0' && editorLangId == 'rocq'"
    },
    {
        "key": "alt+right",
        "command": "-extension.rocq.interpretToPoint",
        "when": "editorTextFocus && config.vsrocq.proof.mode == '0' && editorLangId == 'rocq'"
    },
    {
        "key": "ctrl+right",
        "command": "extension.rocq.interpretToPoint",
        "when": "config.vsrocq.proof.mode == '0' && resourceScheme == 'rocq-view'"
    },
    {
        "key": "alt+right",
        "command": "-extension.rocq.interpretToPoint",
        "when": "config.vsrocq.proof.mode == '0' && resourceScheme == 'rocq-view'"
    },
    {
        "key": "ctrl+end",
        "command": "extension.rocq.interpretToEnd",
        "when": "editorTextFocus && config.vsrocq.proof.mode == '0' && editorLangId == 'rocq'"
    },
    {
        "key": "alt+end",
        "command": "-extension.rocq.interpretToEnd",
        "when": "editorTextFocus && config.vsrocq.proof.mode == '0' && editorLangId == 'rocq'"
    },
    {
        "key": "ctrl+end",
        "command": "extension.rocq.interpretToEnd",
        "when": "config.vsrocq.proof.mode == '0' && resourceScheme == 'rocq-view'"
    },
    {
        "key": "alt+end",
        "command": "-extension.rocq.interpretToEnd",
        "when": "config.vsrocq.proof.mode == '0' && resourceScheme == 'rocq-view'"
    },
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\r"
        },
        "when": "terminalFocus"
    }
]