# Ghostty. Pure cosmetics - edit freely, no rebuild. Ghostty reloads on
# save, or use its "Reload Configuration" binding.
#
# Full reference: `ghostty +show-config --default --docs`

font-family = JetBrainsMono Nerd Font
font-size = 11

# Built-in themes: `ghostty +list-themes`
theme = catppuccin-mocha

background-opacity = 0.95
window-padding-x = 8
window-padding-y = 8
window-decoration = none

cursor-style = block
mouse-hide-while-typing = true

scrollback-limit = 10000
copy-on-select = clipboard

# niri handles window management; don't let ghostty confirm on close.
confirm-close-surface = false
