# Mutable shell config: aliases and interactive cosmetics.
#
# Sourced from ~/.config/zsh/.zshrc (generated by home/shell.nix). Edit
# freely - a new shell picks changes up, or `exec zsh` in the current one.
# NEVER requires nixos-rebuild.
#
# Keep anything here that you might change on a whim. Things that must be
# true for the shell to FUNCTION (plugins, history) belong in home/shell.nix.

# ---------------------------------------------------------------- aliases ---
alias ls='eza --group-directories-first'
alias ll='eza -l --git --group-directories-first'
alias la='eza -la --git --group-directories-first'
alias lt='eza --tree --level=2'

# This config. $NIXOS_REPO is set by home/dotfiles.nix from me.nix, so the
# checkout path is never hard-coded here. No `#<host>` needed: flake.nix
# names every host after its directory.
alias nrs='sudo nixos-rebuild switch --flake "$NIXOS_REPO"'
alias nrb='sudo nixos-rebuild build  --flake "$NIXOS_REPO"'
alias nfu='cd "$NIXOS_REPO" && nix flake update'
alias ngc='sudo nix-collect-garbage --delete-older-than 30d'
alias cfg='cd "$NIXOS_REPO"'
alias dsync='dotfiles-sync'   # push dotfile changes now instead of waiting

# ------------------------------------------------------- fzf-tab cosmetics ---
# Preview pane contents. Purely taste; tweak at will.
zstyle ':fzf-tab:complete:*:*' fzf-preview \
  'if [[ -d $realpath ]]; then eza --tree --level=1 --color=always $realpath;
   else bat --color=always --style=plain --line-range=:40 $realpath 2>/dev/null; fi'
zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
